# ========================================================
# FINANZSHIELD - VARIABLES DE ENTORNO SUPABASE
# ========================================================
# Copia este archivo como .env en la raíz del proyecto y reemplaza
# los valores con las credenciales de tu proyecto Supabase:
# Settings -> API -> Project URL y anon/public key

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-llave-anon-publica-aqui
